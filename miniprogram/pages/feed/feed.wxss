.intro {
  margin-top: 16rpx;
}

.scroller {
  margin-top: 28rpx;
  white-space: nowrap;
  width: 100%;
}

.sorts {
  display: flex;
  margin: 16rpx 0 28rpx;
}

.sort {
  margin-right: 24rpx;
  color: #6E655A;
  font-size: 26rpx;
}

.sort-on {
  color: #2A2622;
  border-bottom: 2rpx solid #A85B45;
}

.section {
  margin: 8rpx 0 16rpx;
  color: #6E655A;
  font-size: 22rpx;
  letter-spacing: 6rpx;
}

.post {
  margin-bottom: 24rpx;
}

.row-card {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.thumb {
  width: 168rpx;
  flex: none;
}

.copy {
  flex: 1;
  min-width: 0;
}

.tags {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 36rpx;
  line-height: 1.35;
  font-weight: 600;
}

.blurb,
.item-line,
.foot {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.votes {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 26rpx;
}

.tiny {
  font-size: 22rpx;
}

.brass {
  color: #A85B45;
}

.empty {
  padding: 48rpx 28rpx;
}

.small {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.note {
  margin-top: 12rpx;
  font-size: 24rpx;
}
