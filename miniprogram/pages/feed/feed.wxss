.intro {
  margin-top: 16rpx;
}

.post {
  margin-bottom: 24rpx;
}

.row-card {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.thumb {
  width: 168rpx;
  flex: none;
}

.copy {
  flex: 1;
  min-width: 0;
}

.tags {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.title {
  margin-top: 12rpx;
  font-size: 36rpx;
  line-height: 1.35;
  font-weight: 600;
}

.blurb,
.foot {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.votes {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 26rpx;
}

.tiny {
  font-size: 22rpx;
}

.brass {
  color: #A85B45;
}

.empty {
  padding: 48rpx 28rpx;
}

.small {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.note {
  margin-top: 12rpx;
  font-size: 24rpx;
}
