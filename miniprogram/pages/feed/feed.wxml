<view class="page">
  <view class="h1">还挂在门后的衣服</view>
  <view class="muted intro">都是别人拿不定主意的衣服。先看新发上来的——投一票，或者说一句你实际看到的。</view>

  <view wx:if="{{empty}}" class="card empty">
    <view class="h1 small">还没有人拿不定主意</view>
    <view class="muted">把你那件拿不定的发上来，让别人帮你看一眼。</view>
    <navigator class="btn gap" url="/pages/compose/compose" hover-class="none">发一条纠结</navigator>
  </view>

  <view wx:if="{{!empty}}" class="card post row-card" wx:for="{{posts}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
    <view class="thumb"><look illustration="{{item.illustration}}" image="{{item.image}}" category="{{item.category}}" framed="{{false}}" /></view>
      <view class="copy">
        <view class="tags">
          <text class="tag tag-{{item.tone}}">{{item.deadline}}</text>
          <text class="muted tiny">{{item.kindLabel}}</text>
          <text wx:if="{{item.images.length > 1}}" class="muted tiny">{{item.images.length}} 张照片</text>
          <text wx:if="{{item.mine}}" class="tiny brass">你发的</text>
          <text wx:if="{{item.myVoteLabel}}" class="tiny">{{item.myVoteLabel}}</text>
        </view>
        <view class="title">{{item.title}}</view>
        <view class="muted blurb">{{item.blurb}}</view>
        <view class="votes">
          <text class="keep">留 {{item.keep}}</text>
          <text class="muted tiny">{{item.peopleLine}}</text>
          <text class="return">退 {{item.ret}}</text>
        </view>
        <view class="bar">
          <view class="bar-keep" style="width: {{item.keepShare}}%;"></view>
          <view class="bar-return" style="width: {{item.returnShare}}%;"></view>
        </view>
        <view class="muted tiny foot">{{item.opinions.length}} 条评论与补充 · {{item.who}}</view>
      </view>
    </view>

  <view class="muted note">标着「示意图」的是示例。登录之后，你发的和投的会记在账号里。</view>
  <dock current="feed" />
</view>
