<view class="page" wx:if="{{missing}}">
  <view class="h1">没找到这条纠结</view>
  <view class="muted gap">示例一直都在。你自己发的如果清掉了，就找不回来了。</view>
  <view class="btn gap" bindtap="back">回到社区</view>
</view>

<view class="page" wx:elif="{{post}}">
  <view class="muted back" bindtap="back">返回社区</view>
  <view wx:if="{{post.images.length}}" class="gallery">
    <swiper class="photo-swiper" current="{{photoIndex}}" bindchange="onPhotoChange">
      <swiper-item wx:for="{{post.images}}" wx:key="*this">
        <image class="detail-photo" src="{{item}}" mode="aspectFit" data-url="{{item}}" bindtap="previewPhoto" />
      </swiper-item>
    </swiper>
    <view class="muted tiny photo-count">{{photoIndex + 1}} / {{post.images.length}} · 点图片查看大图</view>
  </view>
  <view wx:else class="hero">
    <look illustration="{{post.illustration}}" image="{{post.image}}" category="{{post.category}}" />
  </view>
  <view class="item-line">{{post.item || post.category}} · {{post.priceText}}{{post.channel ? ' · ' + post.channel : ''}}</view>
  <view class="tags">
    <text class="tag tag-{{post.tone}}">{{post.deadline}}</text>
    <text class="tag">{{post.kindLabel}}</text>
    <text class="tag tag-{{post.verdictTone}}">{{post.verdictLabel}}</text>
  </view>
  <view class="h1 title">{{post.title}}</view>
  <view class="muted tiny">{{post.who}}</view>
  <view class="story">{{post.story}}</view>

  <view class="card block">
    <view class="votes">
      <text class="keep">留 {{post.keep}}</text>
      <text class="muted tiny">{{post.voteLine}}</text>
      <text class="return">退 {{post.ret}}</text>
    </view>
    <view class="bar">
      <view class="bar-keep" style="width: {{post.keepShare}}%;"></view>
      <view class="bar-return" style="width: {{post.returnShare}}%;"></view>
    </view>
    <view wx:if="{{post.decision}}" class="muted gap">已经决定了，投票停了。</view>
    <view wx:elif="{{post.mine}}" class="muted gap">这是你发的，不用给自己投票。听完别人的，再决定留还是退。</view>
    <view wx:else class="actions">
      <view class="btn {{post.myVote == 'keep' ? 'btn-keep' : 'btn-line'}}" data-stance="keep" bindtap="vote">留下</view>
      <view class="btn {{post.myVote == 'return' ? 'btn-return' : 'btn-line'}}" data-stance="return" bindtap="vote">退掉</view>
    </view>
    <view wx:if="{{post.mine}}" class="btn btn-primary gap" bindtap="decide">{{post.decision ? '修改结论' : '我决定了'}}</view>
    <view wx:if="{{post.decision == 'kept'}}" class="stamp keep">已经留下</view>
    <view wx:if="{{post.decision == 'returned'}}" class="stamp return">已经退掉</view>
  </view>

  <view class="section">评论与补充 <text class="muted tiny">{{post.opinions.length}}</text></view>
  <view wx:if="{{post.opinions.length == 0}}" class="muted empty-note">{{post.mine ? '还没有人来看。你可以先写一句你最担心的。' : '还没人说话。你先看的话，留一句你实际看到的。'}}</view>
  <view class="card opinion" wx:for="{{post.opinions}}" wx:key="id">
    <view class="row between">
      <text class="tag tag-{{item.stance}}">{{item.stanceLabel}}</text>
      <text wx:if="{{item.mine}}" class="tiny" data-id="{{item.id}}" bindtap="withdraw">撤回</text>
    </view>
    <view class="body">{{item.text}}</view>
    <view class="muted tiny">{{item.who}}{{item.mine ? ' · 你写的' : ''}}</view>
  </view>

  <view wx:if="{{loggedIn}}" class="comment-form">
  <view class="form-title">{{post.mine ? '补充想法' : '写评论'}}</view>
  <view wx:if="{{!post.mine}}" class="muted tiny">可以聊版型、颜色或搭配，写你实际看到的。</view>
  <view wx:if="{{!post.mine}}" class="row stances">
    <view
      wx:for="{{stances}}"
      wx:key="id"
      class="chip {{stance == item.id ? 'chip-on' : ''}}"
      data-id="{{item.id}}"
      bindtap="setStance"
    >{{item.label}}</view>
  </view>
  <textarea class="field area" placeholder="{{post.mine ? '补充你的想法…' : '写下你的看法…'}}" value="{{text}}" maxlength="180" bindinput="onText" show-confirm-bar="{{false}}" />
  <view class="muted tiny count">{{text.length}} / 180</view>
  <view class="field-label">署名</view>
  <input class="field" placeholder="怎么称呼你" value="{{author}}" maxlength="12" bindinput="onAuthor" />
  <view wx:if="{{error}}" class="return tiny">{{error}}</view>
  <button class="btn btn-primary gap" bindtap="send" disabled="{{sending}}" loading="{{sending}}">{{post.mine ? '发布补充' : '发布评论'}}</button>
  </view>
  <view wx:else class="comment-form">
    <view class="muted">登录后才能评论</view>
    <view class="btn btn-primary gap" bindtap="login">去登录</view>
  </view>
</view>
