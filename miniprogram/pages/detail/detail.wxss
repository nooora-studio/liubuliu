.back {
  margin-bottom: 20rpx;
}

.hero {
  width: 56%;
  max-width: 420rpx;
  margin: 0 auto;
}

.item-line,
.story,
.body {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.tags,
.stances {
  margin-top: 20rpx;
}

.title {
  margin-top: 20rpx;
  font-size: 44rpx;
}

.tiny {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.block,
.opinion {
  margin-top: 20rpx;
}

.votes {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.actions .btn {
  flex: 1;
}

.btn-keep {
  background: #5E7565;
  color: #FDFBF7;
  border: none;
}

.btn-return {
  background: #A85B45;
  color: #FDFBF7;
  border: none;
}

.gap {
  margin-top: 24rpx;
}

.stamp {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.section {
  margin-top: 40rpx;
  color: #6E655A;
  font-size: 32rpx;
  font-weight: 600;
}

.between {
  justify-content: space-between;
}

.comment-form {
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(42, 38, 34, 0.14);
}

.form-title { font-size: 32rpx; font-weight: 600; }
.field-label { margin-top: 24rpx; font-size: 24rpx; }
.empty-note { margin-top: 16rpx; font-size: 26rpx; }
.count { text-align: right; }
.stances { gap: 12rpx; }
.stances .chip { margin-right: 0; }
.photo-swiper { height: 760rpx; }
.detail-photo { width: 100%; height: 100%; }
.gallery { background: #FDFBF7; padding: 12rpx; }
.photo-count { padding: 8rpx 12rpx; text-align: center; }
.body, .story { overflow-wrap: break-word; white-space: pre-wrap; }
.tag-style { letter-spacing: 0; }

input.field {
  height: 88rpx;
  padding: 0 20rpx;
  line-height: normal;
}

.field {
  margin-top: 16rpx;
  width: 100%;
  box-sizing: border-box;
  background: #FDFBF7;
  border: 1rpx solid rgba(42, 38, 34, 0.14);
  padding: 20rpx;
  font-size: 28rpx;
}

.area {
  height: 240rpx;
  line-height: 1.6;
}
