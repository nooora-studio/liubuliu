<view class="page">
  <view class="h1">把那件衣服放上来</view>
  <view class="muted intro">说说你自己拿不准的地方：是不是跟已有的重了、打算配什么、最担心哪里。这些写清楚，比问“好看吗”管用。</view>

  <view class="label">照片 <text class="muted tiny">{{images.length}} / 9</text></view>
  <view class="muted tiny photo-hint">可以放实拍、想搭的风格，或者不同搭配。第一张当封面。</view>
  <view class="photo-grid">
    <view class="photo-tile" wx:for="{{images}}" wx:key="*this">
      <image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewPhoto" />
      <view class="remove-photo" data-index="{{index}}" catchtap="removePhoto">×</view>
      <view class="cover-photo" data-index="{{index}}" catchtap="makeCover">{{index == 0 ? '封面' : '设为封面'}}</view>
    </view>
    <view wx:if="{{images.length < 9}}" class="add-photo" bindtap="choosePhoto">{{reading ? '处理中…' : '+ 添加照片'}}</view>
  </view>
  <view class="muted tiny">没有照片也行。选一个接近的示意图，别人就知道你在问哪一类。</view>

  <view wx:if="{{!images.length}}" class="illustration-preview">
    <look illustration="{{illustration}}" category="{{category}}" />
  </view>
  <view wx:if="{{!images.length}}">
  <view class="label">示意图</view>
  <view class="wrap">
    <view
      wx:for="{{illustrations}}"
      wx:key="id"
      class="chip {{illustration == item.id ? 'chip-on' : ''}}"
      data-id="{{item.id}}"
      bindtap="setIllustration"
    >{{item.label}}</view>
  </view>
  </view>

  <view class="label">你在问什么</view>
  <view class="wrap">
    <view wx:for="{{kinds}}" wx:key="id" class="chip {{kind == item.id ? 'chip-on' : ''}}" data-id="{{item.id}}" bindtap="setKind">{{item.label}}</view>
  </view>

  <view class="label">哪一类</view>
  <view class="wrap">
    <view wx:for="{{categories}}" wx:key="*this" class="chip {{category == item ? 'chip-on' : ''}}" data-id="{{item}}" bindtap="setCategory">{{item}}</view>
  </view>

  <view class="label">一句话</view>
  <input class="field" placeholder="例如：骆驼色大衣，明天就得决定退不退" value="{{title}}" maxlength="40" bindinput="onTitle" />
  <view wx:if="{{errors.title}}" class="return tiny">{{errors.title}}</view>

  <view class="label">说说你的纠结</view>
  <textarea class="field area" placeholder="想要什么效果？放了几张的话，按顺序说说分别想搭什么。" value="{{story}}" maxlength="400" bindinput="onStory" />
  <view wx:if="{{errors.story}}" class="return tiny">{{errors.story}}</view>

  <view class="label">这件是什么</view>
  <input class="field" placeholder="例如：米白圆领针织" value="{{item}}" maxlength="24" bindinput="onItem" />

  <view class="label">价格，可以空着</view>
  <input class="field" placeholder="数字" type="number" value="{{price}}" maxlength="6" bindinput="onPrice" />
  <view wx:if="{{errors.price}}" class="return tiny">{{errors.price}}</view>

  <view class="label">在哪买的</view>
  <input class="field" placeholder="专柜、优衣库、直播间" value="{{channel}}" maxlength="16" bindinput="onChannel" />

  <view class="label">还能退几天</view>
  <view class="wrap">
    <view wx:for="{{days}}" wx:key="label" class="chip {{dayIndex == index ? 'chip-on' : ''}}" data-index="{{index}}" bindtap="setDay">{{item.label}}</view>
  </view>

  <button class="btn btn-primary submit" bindtap="submit" disabled="{{reading || submitting}}" loading="{{submitting}}">{{submitting ? '正在发布…' : '发到社区'}}</button>
</view>
