.intro {
  margin: 16rpx 0 28rpx;
}

.gap {
  margin-top: 20rpx;
  gap: 16rpx;
}

.side {
  margin-left: 16rpx;
}

.tiny {
  margin-top: 12rpx;
  font-size: 22rpx;
}

.label {
  margin-top: 36rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wrap .chip {
  margin-right: 0;
  margin-bottom: 8rpx;
}

.field {
  width: 100%;
  box-sizing: border-box;
  background: #FDFBF7;
  border: 1rpx solid rgba(42, 38, 34, 0.14);
  padding: 20rpx;
  font-size: 28rpx;
}

.area {
  height: 220rpx;
  line-height: 1.6;
}

input.field {
  height: 88rpx;
  padding: 0 20rpx;
  line-height: normal;
}

.photo-hint { margin-bottom: 20rpx; }
.photo-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.photo-tile, .add-photo { width: calc((100% - 24rpx) / 3); height: 224rpx; position: relative; }
.photo-tile image { width: 100%; height: 100%; }
.remove-photo { position: absolute; right: 4rpx; top: 4rpx; width: 56rpx; height: 56rpx; line-height: 52rpx; text-align: center; background: #2A2622; color: #fff; font-size: 36rpx; }
.cover-photo { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(42,38,34,.72); color: #fff; padding: 8rpx; text-align: center; font-size: 22rpx; }
.add-photo { display: flex; align-items: center; justify-content: center; border: 1rpx dashed rgba(42,38,34,.24); box-sizing: border-box; background: #FDFBF7; font-size: 24rpx; }
.illustration-preview { width: 40%; margin: 24rpx auto 0; }

.submit {
  margin-top: 40rpx;
}
