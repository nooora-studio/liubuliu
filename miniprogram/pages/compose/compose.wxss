.intro {
  margin: 16rpx 0 28rpx;
}

.gap {
  margin-top: 20rpx;
  gap: 16rpx;
}

.side {
  margin-left: 16rpx;
}

.tiny {
  margin-top: 12rpx;
  font-size: 22rpx;
}

.label {
  margin-top: 36rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wrap .chip {
  margin-right: 0;
  margin-bottom: 8rpx;
}

.field {
  width: 100%;
  box-sizing: border-box;
  background: #f7f3eb;
  border: 1rpx solid rgba(28, 25, 21, 0.16);
  padding: 20rpx;
  font-size: 28rpx;
}

.area {
  height: 220rpx;
}

.submit {
  margin-top: 40rpx;
}
