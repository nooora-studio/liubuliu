/* 宣纸 · 赤陶 —— 唯一视觉方案
   暖白打底 + 暖墨文字 + 赤陶强调；留=灰绿，退=赤陶。
   图片不做任何滤镜，用户传什么展示什么。 */

page {
  background: #F5F1E9;
  color: #2A2622;
  font-size: 28rpx;
  line-height: 1.55;
}

.page {
  padding: 28rpx 28rpx 180rpx;
}

.h1 {
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 600;
}

.muted {
  color: #6E655A;
}

.card {
  background: #FDFBF7;
  border: 1rpx solid rgba(42, 38, 34, 0.12);
  border-radius: 16rpx;
  padding: 20rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border: 1rpx solid rgba(42, 38, 34, 0.14);
  background: #FDFBF7;
  border-radius: 999rpx;
  font-size: 26rpx;
  white-space: nowrap;
}

.chip-on {
  background: #A85B45;
  color: #FFFFFF;
  border-color: #A85B45;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 14rpx;
  margin-right: 12rpx;
  border: 1rpx solid rgba(42, 38, 34, 0.14);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #6E655A;
}

.tag-urgent {
  color: #A85B45;
  border-color: rgba(168, 91, 69, 0.35);
  background: rgba(168, 91, 69, 0.08);
}

.tag-done,
.tag-keep {
  color: #5E7565;
  border-color: rgba(94, 117, 101, 0.35);
  background: rgba(94, 117, 101, 0.08);
}

.tag-return {
  color: #A85B45;
  border-color: rgba(168, 91, 69, 0.35);
}

.tag-style {
  color: #A85B45;
  border-color: rgba(168, 91, 69, 0.35);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 28rpx;
  background: #2A2622;
  color: #FDFBF7;
  font-size: 28rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  line-height: normal;
}

button.btn { margin-left: 0; margin-right: 0; width: 100%; }
button.btn::after { border: none; }
button.btn[disabled] { background: #A0988A; color: #FDFBF7; opacity: .7; }

.btn-line {
  background: transparent;
  color: #2A2622;
  border: 1rpx solid rgba(42, 38, 34, 0.2);
}

/* 主行动：发布 / 提交，用品牌赤陶 */
.btn-primary {
  background: #A85B45;
  color: #FFFFFF;
}

.row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.bar {
  display: flex;
  height: 6rpx;
  margin-top: 12rpx;
  background: rgba(42, 38, 34, 0.1);
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-keep {
  background: #5E7565;
  height: 100%;
}

.bar-return {
  background: #A85B45;
  height: 100%;
}

.keep {
  color: #5E7565;
}

.return {
  color: #A85B45;
}
