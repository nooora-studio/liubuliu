.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #f7f3eb;
  border-top: 1rpx solid rgba(28, 25, 21, 0.12);
}

.item,
.post {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #5c5348;
  line-height: 112rpx;
}

.on {
  color: #1c1915;
  font-weight: 600;
}

.post {
  color: #f7f3eb;
  background: #1c1915;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0 12rpx;
}
