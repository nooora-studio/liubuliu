.dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FDFBF7;
  border-top: 1rpx solid rgba(42, 38, 34, 0.12);
}

.item,
.post {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #6E655A;
  line-height: 112rpx;
}

.on {
  color: #2A2622;
  font-weight: 600;
}

.post {
  color: #FFFFFF;
  background: #A85B45;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  margin: 0 12rpx;
}
