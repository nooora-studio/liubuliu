<view class="frame" wx:if="{{framed}}">
  <view wx:if="{{image}}" class="photo-wrap">
    <image class="photo" src="{{image}}" mode="aspectFill" />
  </view>
  <view wx:else class="sheet sheet-{{illustration}}"></view>
  <view class="cap">
    <text>{{category || "衣服"}}</text>
    <text>{{image ? "实拍" : "示意图"}}</text>
  </view>
</view>
<view wx:else class="sheet sheet-{{illustration}}"></view>
